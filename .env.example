# ── 이 파일은 git 에 올라가는 견본이다. 실제 키는 넣지 말고, 복사한 .env 에 넣는다:  cp .env.example .env ──
# 둘 중 하나만 채운다. 둘 다 비우면 서버가 목업 모드로 뜬다.

# [A] Claude (기본)
ANTHROPIC_API_KEY=
# TALKBUDDY_MODEL=claude-opus-5-5      # 더 저렴하게: claude-sonnet-5-5, claude-haiku-4-5

# [B] Kimi (Moonshot, Anthropic 호환 엔드포인트) — 위 ANTHROPIC_API_KEY 는 비우고 아래 세 줄 주석 해제
# ANTHROPIC_BASE_URL=https://api.moonshot.ai/anthropic
# ANTHROPIC_AUTH_TOKEN=                # Kimi 키 (Bearer 로 전송됨)
# TALKBUDDY_MODEL=kimi-k3              # 콘솔에서 사용 가능한 모델명 확인

# 선택: 키가 있어도 목업으로 강제
# MOCK=1
